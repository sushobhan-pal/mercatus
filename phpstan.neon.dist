parameters:
	level: 8
	paths:
		- mercatus.php
		- src
		- tests
	excludePaths:
		- tests/Architecture/Fixtures
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/wordpress-tests-stubs/wordpress-tests-stubs.php
	ignoreErrors:
		# The integration bootstrap enables HPOS through WooCommerce internals that the published stubs leave out.
		-
			identifier: class.notFound
			path: tests/bootstrap-integration.php
